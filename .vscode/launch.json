{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Flask Backend (port 5000)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/run.py",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend",
        "FLASK_ENV": "development",
        "PORT": "5000"
      }
    },
    {
      "name": "Python: Run Automated Tests",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/test_api.py",
      "console": "integratedTerminal"
    }
  ]
}
